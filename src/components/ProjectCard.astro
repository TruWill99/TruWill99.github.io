---
export interface Props {
  title: string;
  subtitle?: string;
  description: string;
  tech: string[];
  link?: string;
  video?: string;
  image?: string;
  openSource?: boolean;
  buttons?: { label: string; url: string; type?: "primary" | "ghost" }[];
}
const {
  title,
  subtitle,
  description,
  tech,
  link = "#",
  video,
  image,
  openSource = false,
  buttons = [{ label: "View Project", url: link, type: "primary" }],
} = Astro.props;
---

<div class="card">
  <div class="termbar">
    <h3 class="termbar__title">
      <a href={link} target="_blank" rel="external">{title}</a>
    </h3>
    {openSource && (
      <span class="oss-badge">open source</span>
    )}
  </div>

  {video && (
    <div class="media">
      <video
        src={video}
        muted
        autoplay
        loop
        playsinline
        preload="auto"
        disablepictureinpicture
        controlslist="nodownload noplaybackrate noremoteplayback"
        aria-hidden="true"
      ></video>
    </div>
  )}
  
  {image && !video && (
    <div class="media">
      <img src={image} alt={`${title} thumbnail`} loading="lazy" />
    </div>
  )}

  <div class="content">
    {subtitle && <p class="card__subtitle">{subtitle}</p>}
    <p class="card__desc">{description}</p>

    <div class="tech-badges">
      {tech.map(t => <span class="tech-badge">{t}</span>)}
    </div>

    <div class="links">
      {buttons.map(btn => (
        <a
          class={`btn btn--${btn.type || "ghost"}`}
          href={btn.url}
          target="_blank"
          rel="external"
        >
          {btn.label}
        </a>
      ))}
    </div>
  </div>
</div>

<style>
  .card {
    position: relative;
    z-index: 1;
    border: 1px solid var(--border-color);
    border-radius: 0;
    background: linear-gradient(180deg, rgba(255,255,255,.03), transparent 52%), var(--bg-card);
    box-shadow: 0 10px 26px rgba(0,0,0,0.4);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: border-color 0.16s ease, box-shadow 0.16s ease;
  }
  .card:hover {
    border-color: var(--text-accent);
    box-shadow: 0 14px 34px rgba(0,0,0,0.5);
  }

  .termbar {
    padding: 12px 16px;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border-bottom: 1px solid var(--border-color);
    background: var(--tokyo-bg);
  }
  .termbar__title {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
  }
  .termbar__title a {
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.16s ease;
  }
  .termbar__title a:hover {
    color: var(--text-accent);
    text-decoration: underline;
  }
  .oss-badge {
    margin-left: auto;
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.15rem 0.7rem;
    background: var(--border-color);
    color: var(--text-muted);
  }

  .media {
    position: relative;
    background: var(--tokyo-bg);
    overflow: hidden;
    border-bottom: 1px solid var(--border-color);
  }
  .media video,
  .media img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16/9;
    object-fit: cover;
  }

  .content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
  }
  .card__subtitle {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-accent);
  }
  .card__desc {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-secondary);
    flex: 1;
  }

  .tech-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.25rem;
  }
  .tech-badge {
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.8rem;
    background: var(--tokyo-bg);
    color: var(--text-accent);
    border: 1px solid var(--border-color);
    transition: border-color 0.16s ease;
  }
  .tech-badge:hover {
    border-color: var(--text-accent);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  .btn {
    font-size: 0.85rem;
    font-weight: 500;
    padding: 0.4rem 1.2rem;
    text-decoration: none;
    transition: all 0.16s ease;
    border: 1px solid transparent;
  }
  .btn--primary {
    background: var(--text-accent);
    color: var(--tokyo-bg);
  }
  .btn--primary:hover {
    background: var(--accent-hover);
    color: var(--tokyo-bg);
  }
  .btn--ghost {
    border-color: var(--border-color);
    color: var(--text-secondary);
  }
  .btn--ghost:hover {
    border-color: var(--text-accent);
    color: var(--text-accent);
  }
</style>
